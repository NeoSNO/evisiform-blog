---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.href,
  publisher: { '@type': 'Organization', name: SITE.appName, url: SITE.appUrl },
};
---

<Base title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <h1>Visitor management, made simple</h1>
    <p>{SITE.description}</p>
  </section>

  <section class="post-list" aria-label="Latest posts">
    {posts.map((post) => (
      <article class="card">
        {post.data.cover && (
          <a href={`/${post.id}`} tabindex="-1" aria-hidden="true">
            <img src={post.data.cover} alt="" loading="lazy" width="1200" height="630" />
          </a>
        )}
        <div class="card-body">
          <p class="meta">
            {post.data.category && <span class="tag">{post.data.category}</span>}
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </p>
          <h2><a href={`/${post.id}`}>{post.data.title}</a></h2>
          <p>{post.data.summary ?? post.data.description}</p>
          <a href={`/${post.id}`} class="read-more">Read more →</a>
        </div>
      </article>
    ))}
  </section>
</Base>
